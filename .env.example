# --- Required ---
PINECONE_API_KEY=your-pinecone-api-key

# --- Vector store ---
PINECONE_INDEX_NAME=medical-chatbot
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1

# --- Embeddings ---
# Used by BOTH ingest and the API. Changing it requires `python -m scripts.ingest --recreate`;
# the API refuses to start if the index dimension doesn't match the model.
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- LLM: "ollama" (local, default) or "openai" ---
LLM_PROVIDER=ollama
OLLAMA_MODEL=gemma3:4b
OLLAMA_BASE_URL=http://localhost:11434
# OPENAI_API_KEY=sk-...           # required when LLM_PROVIDER=openai
# OPENAI_MODEL=gpt-4o-mini
# LLM_TEMPERATURE=0

# --- Retrieval / memory ---
# RETRIEVER_K=4
# MIN_RELEVANCE_SCORE=0.40          # drop chunks below this cosine score; 0 disables
# MEMORY_MAX_TURNS=10
# MEMORY_TTL_SECONDS=3600

# --- Chat memory backend ---
# memory: in-process (single worker only). redis: shared by all workers/containers.
# MEMORY_BACKEND=memory
# local: `docker compose up -d redis` → redis://localhost:6379/0 (the default)
# REDIS_URL=redis://localhost:6379/0     # rediss://:password@host:6380/0 for TLS + auth
# REDIS_KEY_PREFIX=medical-rag:chat:

# --- Timeouts and retries ---
# LLM_TIMEOUT_SECONDS=30             # no bytes from the LLM for this long -> 503 (ChatOpenAI + Ollama)
# LLM_MAX_RETRIES=2                  # OpenAI only, before the first token
# CONDENSE_TIMEOUT_SECONDS=10        # rewrite step; on timeout/failure: dual-retrieval fallback
# RETRIEVAL_TIMEOUT_SECONDS=5        # per Pinecone attempt
# RETRIEVAL_MAX_ATTEMPTS=3           # retries timeouts, connection errors and 5xx (never 4xx)
# REQUEST_TIMEOUT_SECONDS=45         # overall cap: /api/chat -> 504, stream -> error event

# --- Rate limiting (chat endpoints only) ---
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_PER_MINUTE=10           # per session
# RATE_LIMIT_PER_IP_PER_MINUTE=30    # per client IP (stops clients rotating session IDs)
# Behind a proxy, set uvicorn's FORWARDED_ALLOW_IPS to the proxy's address (see README).

# --- Readiness ---
# READY_TIMEOUT_SECONDS=5            # per-check limit for GET /ready (Redis ping, Pinecone stats)

# --- Server ---
# CORS_ORIGINS=["http://localhost:3000"]
# LOG_LEVEL=INFO
# LOG_FORMAT=json                    # json (one object per line) | console (readable, for a terminal)
# LOG_CONTENT=false                  # LOCAL DEV ONLY: true adds question + rewritten question to logs
